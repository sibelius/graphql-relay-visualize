{
  "name": "graphql-relay-visualize",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive visualizations of what GraphQL + Relay actually do for you",
  "type": "module",
  "scripts": {
    "schema": "node --no-warnings scripts/print-schema.ts",
    "relay": "relay-compiler",
    "dev": "pnpm schema && relay-compiler && concurrently -k -n relay,next \"relay-compiler --watch\" \"next dev\"",
    "build": "pnpm schema && relay-compiler --validate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "graphql": "^17.0.2",
    "graphql-relay": "^0.11.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-relay": "^21.0.1",
    "relay-runtime": "^21.0.1",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^20.1.1",
    "concurrently": "^10.0.5",
    "relay-compiler": "^21.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.9.0"
}
