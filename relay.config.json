{
  "src": "./src",
  "schema": "./schema.graphql",
  "language": "typescript",
  "artifactDirectory": "./src/__generated__",
  "eagerEsModules": true,
  "excludes": ["**/node_modules/**", "**/__mocks__/**", "**/__generated__/**"],
  "persistConfig": {
    "file": "./persisted_queries.json",
    "algorithm": "MD5"
  }
}
